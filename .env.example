# 이 파일을 복사해서 .env를 만들고 값을 채우세요. .env는 GitHub에 올라가지 않습니다.
PORT=4100
FRONTEND_ORIGIN=http://localhost:3100
# PostgreSQL 접속 주소 (Render의 External Database URL)
DATABASE_URL=
# 로그인 토큰 서명용 임의 문자열 (예: openssl rand -hex 32)
JWT_SECRET=
# 서버를 처음 켤 때 만들어지는 관리자 계정
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=
# GPT API 키 (비워 두면 AI 정리만 꺼지고 나머지는 정상 동작)
GPT_API_KEY=
GPT_MODEL=gpt-5.4-mini
